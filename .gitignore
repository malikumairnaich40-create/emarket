# Local environment and secrets
core/.env
core/.env.*
!core/.env.example

# Installed dependencies
core/vendor/

# Runtime logs and generated framework files
core/storage/logs/*.log
core/storage/framework/cache/data/*
core/storage/framework/sessions/*
core/storage/framework/views/*
core/storage/framework/testing/*
core/bootstrap/cache/*.php

# OS metadata
.DS_Store

# Local database dump may contain environment-specific credentials
installer/database.sql

# Never ignore public assets and storage uploads
!core/public/assets/**
!core/public/images/**
!core/public/uploads/**
!storage/app/public/**
!core/storage/app/public/**
!assets/**

# Runtime public storage link (only ignore the symlink itself if needed)
# /storage
# /core/public/storage

storage/framework/*
storage/logs/*
storage/app/.gitignore
